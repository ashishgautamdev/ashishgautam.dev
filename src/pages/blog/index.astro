---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function fmt(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<Layout title="Writing — Ashish Gautam" description="Notes, essays, and things I've been thinking about.">
  <section class="hero">
    <p class="eyebrow">writing</p>
    <h1>Notes & essays.</h1>
    <p class="lede">
      Things I've been thinking about. Mostly about software, occasionally about
      everything else.
    </p>
  </section>

  <section class="section">
    {
      posts.length === 0 ? (
        <p class="muted">No posts yet. Check back soon.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <time datetime={post.data.pubDate.toISOString()}>
                {fmt(post.data.pubDate)}
              </time>
              <a href={`/blog/${post.slug}`}>
                <span class="post-title">{post.data.title}</span>
                <span class="post-desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
